var $debug = true
for $i in range(1, 20):
  .z-${$i}
    z-index: $i
var $primary = #0d6efd
var $radius = 4px
mixin btn(color: color) =
  color: $color
  border-radius: 4px
.btn
  @btn(#0d6efd)
  &:hover
    color: darken($primary, 10)
.btn-danger
  @btn(red)
  &:hover
    color: darken(red, 10)
.card
  color: #333
  .title
    font-size: 1.25rem
    font-weight: bold
if $debug:
  .card-debug
    outline: 1px solid blue
else:
  .card-fallback
    outline: 0
@media (min-width: 768px)
  .card
    display: flex
